# Copy to .env.enotdev in the enot project root.
# Find the existing nginx network name; see README.md.
ENOTDEV_PROXY_NETWORK=CHANGE_ME
# Random hex password: openssl rand -hex 32.
ENOTDEV_POSTGRES_PASSWORD=CHANGE_ME
# Public half of a VAPID pair: npm run push:keys.
ENOTDEV_VAPID_PUBLIC_KEY=CHANGE_ME
